{
  "description": "Snapshot the live mission data (world info) to a JSON file, then open, rename or export past snapshots.",
  "form": {
    "save": "Save locally",
    "refetch": "Refresh"
  },
  "search": {
    "input": {
      "placeholder": "Search {{total}} snapshots"
    },
    "include-data": "Include file data",
    "no-match": "No snapshots match that search"
  },
  "empty": {
    "title": "No snapshots saved yet",
    "description": "Press Save locally to keep the live world info."
  },
  "file": {
    "input": {
      "placeholder": "Default name: {{filename}}"
    },
    "rename": "Rename",
    "confirm-delete": "Confirm — delete",
    "cancel": "Cancel"
  },
  "notifications": {
    "save": {
      "success": "The file has been saved",
      "error": "Could not save the snapshot. Try again."
    },
    "delete": {
      "success": "The file \"{{filename}}\" has been deleted",
      "error": "Could not delete \"{{filename}}\". Try again."
    },
    "export": {
      "success": "The file has been exported",
      "error": "Could not export the snapshot. Try again."
    },
    "open": {
      "success": "The file \"{{filename}}\" has been opened",
      "error": "Could not open \"{{filename}}\". Try again."
    },
    "rename": {
      "success": "The file has been renamed",
      "error": "Could not rename the snapshot. Try again."
    }
  },
  "current": {
    "title": "Live world info",
    "loaded": "Loaded, ready to save as {{date}}",
    "fetching": "Fetching the latest world info…",
    "empty": "Not loaded. Refresh to fetch it."
  },
  "files": {
    "title": "Saved snapshots"
  }
}
