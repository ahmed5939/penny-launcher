# Custom files
ignore-*

# Local portable toolchain (e.g. bundled Node runtime)
.toolchain/

# Local Electron data dumps — never commit these.
# `undefined/` is created when appData resolves to undefined (path.join coercion).
/undefined/
undefined/
**/penny-launcher-data/

# Account credential stores (encrypted or plaintext) and atomic-write leftovers
accounts.json
dev-accounts.json
accounts.json.bak
dev-accounts.json.bak
accounts.json.tmp
dev-accounts.json.tmp

# Accidental settings dumps at the repo root (locale JSON lives under src/)
/settings.json
/dev-settings.json
/i18n.json
/friends.json
/automation.json
/taxi-service.json
/auto-llamas.json
/window-state.json
/endurance.json
/customizable-menu.json
/mini-bosses.json
/urns.json
/pegleg-items.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock
.DS_Store

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Webpack
.webpack/

# Vite
.vite/

# Electron-Forge
out/

# Outpost report exports (runtime output)
/reports/
